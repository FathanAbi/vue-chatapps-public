DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# SEC-008: the canonical API origin (used for serverURL and CSRF).
SERVER_URL=https://api.example.com

# SEC-008: comma-separated list of allowed frontend origins (CORS + CSRF).
FRONTEND_ORIGINS=https://app.example.com

# B1: base URL of the SPA, used to build password-reset links in outbound
# email (e.g. "${APP_URL}/reset-password?token=..."). Falls back to the first
# FRONTEND_ORIGINS entry, then to http://localhost:5173.
# APP_URL=https://app.example.com

# SEC-008: force the `Secure` cookie flag on or off. When unset it defaults to
# true in production or when SERVER_URL is https.
# COOKIE_SECURE=true

# B1: SMTP transport for the password-reset email. Email verification is
# disabled, so this is used by forgot-password only. When SMTP_HOST is empty,
# Payload logs outbound mail, and in non-production the reset link is also
# printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Aplikasi Chat
